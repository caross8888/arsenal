// Cloudflare Workers 복제 사이트 설정(사용자 지정 — Vercel 무료 한도 때문에 이전 준비).
// 정적 파일(arsenal-dashboard/public)은 Worker를 거치지 않고 바로 나간다(요청 수 무제한·무료).
// Worker는 /api/* 요청에만 실행된다(run_worker_first) — 하루 10만 건 무료 한도에 들어가는 건 API뿐.
// 없는 주소는 index.html로(single-page-application) — Vercel의 rewrites "/(.*) → /index.html"과 같은 역할.
// Vercel 배포에는 영향이 없다(Vercel은 arsenal-dashboard/를 루트로 쓴다).
{
  "name": "arsenal",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 요청별 로그(주소·CPU 시간) — 관찰 가능성 탭에서 무거운 요청을 찾는다. 무료 하루 20만 건, 정적 파일은 Worker를 안 거쳐 안 잡힌다.
  // 비밀이 아닌 설정값은 여기에 둔다 — 대시보드에서 "텍스트"로 넣은 변수는 다음 Git 배포 때 지워진다
  // (KV 주소가 이렇게 빠져서 번역이 저장되지 않고 미디어 탭마다 약 8,000자씩 새로 번역됐다).
  // 토큰·API 키는 대시보드에서 "비밀(Secret)"로 넣는다 — 비밀은 배포해도 남는다.
  "vars": { "KV_REST_API_URL": "https://mutual-octopus-165170.upstash.io" },
  // Worker Previews는 운영 설정을 상속하지 않으므로 별도로 지정한다.
  // 공개된 테스트 전용 키: 운영 키가 아니며 운영 토큰/랭킹과 호환되지 않는다.
  // 프리뷰에서는 KV 연결을 비워 운영 데이터에 읽기·쓰기를 하지 않는다.
  "previews": {
    "vars": {
      "KV_REST_API_URL": "",
      "KV_REST_API_TOKEN": "",
      "WHOAMI_SECRET": "career-preview-only-not-for-production"
    },
    "placement": { "mode": "smart" }
  },
  // 자기 도메인(사용자 구매, 가비아 → Cloudflare 네임서버). 연결하면 DNS 레코드·인증서를 Cloudflare가 만든다.
  // workers.dev와 달리 Cache API가 동작한다.
  "routes": [
    { "pattern": "coyg.co.kr", "custom_domain": true },
    { "pattern": "www.coyg.co.kr", "custom_domain": true }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Smart Placement — 한국 요청이 LAX 등 먼 곳에서 실행돼 Upstash(미국 동부)를 여러 번 왕복하며 랭킹이 느렸다.
  // DB를 자주 부르는 Worker를 DB 가까이에서 실행한다(무료). 정적 파일은 Worker를 안 거치니 영향 없다.
  "placement": { "mode": "smart" },
  // 크론 — 5분마다 AI 경기 해설 미리 만들기(이미 최신이면 KV 확인만), 매년 5/25 KV 정리.
  // 처리는 cloudflare/worker.js의 CRONS. 시각은 UTC.
  "triggers": { "crons": ["*/5 * * * *", "0 4 25 5 *"] },
  "assets": {
    "directory": "./arsenal-dashboard/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
