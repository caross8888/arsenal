{
  "version": 2,
  "buildCommand": "echo 'no build needed'",
  "outputDirectory": "moved",
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "codex/**": false,
      "work": false
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
